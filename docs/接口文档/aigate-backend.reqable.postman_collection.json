            ],
            "url": "{{api_base}}/v1/roles",
            "description": "## 列出角色\n\n`GET /v1/roles`\n\n含系统角色：`platform_admin`（平台管理员）、`project_member`（项目成员）。"
          }
        },
        {
          "name": "创建角色",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/roles",
            "description": "## 创建角色\n\n`POST /v1/roles`\n\n`code` 需小写；系统角色不可通过普通 CRUD 删除或改码。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"finance\",\n  \"name\": \"财务只读\",\n  \"description\": \"财务/审计只读角色\"\n}"
            }
          }
        },
        {
          "name": "更新角色",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/roles/{{role_id}}",
            "description": "## 更新角色\n\n`PUT /v1/roles/{id}`\n\n可改名称与说明；系统角色限制更多。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"财务只读\",\n  \"description\": \"已更新说明\"\n}"
            }
          }
        },
        {
          "name": "删除角色",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/roles/{{role_id}}",
            "description": "## 删除角色\n\n`DELETE /v1/roles/{id}`\n\n仅自定义角色可删。"
          }
        }
      ]
    },
    {
      "name": "04 部门管理",
      "item": [
        {
          "name": "列出部门",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/organizations",
            "description": "## 列出部门\n\n`GET /v1/organizations`\n\nMVP 组织深度：租户 → 部门 → 员工。"
          }
        },
        {
          "name": "创建部门",
          "request": {
