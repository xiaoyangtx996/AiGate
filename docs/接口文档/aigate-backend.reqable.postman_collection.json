          "name": "列出租户 MCP 目录",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/v1/mcp/assets",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "注册私有 MCP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/v1/mcp/assets",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"????\", \"endpoint\": \"http://127.0.0.1:19090/mcp\", \"credential\": \"replace-at-runtime\", \"version\": \"1.0\"}"
            }
          }
        },
        {
          "name": "授权 MCP 到项目",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/mcp/{{mcp_asset_id}}/grants",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"agent_id\": \"\"}"
            }
          }
        },
        {
          "name": "代理调用 MCP 工具",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/mcp/{{mcp_asset_id}}/invoke",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"echo\", \"arguments\": {\"text\": \"hello\"}}}"
            }
          }
        },
        {
          "name": "列出项目已授权 MCP",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/projects/{{project_id}}/mcp/assets",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "仅返回已进行项目级空 agent_id 授权的 MCP 资产。"
          }
        }
      ]
    },
    {
      "name": "11 项目 Agent 与管理 Bot（Plan 06）",
      "item": [
        {
          "name": "创建项目 Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/agents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"????\", \"model\": \"step-3.5-flash\", \"system_prompt\": \"?????????\", \"knowledge_base_ids\": [\"{{knowledge_base_id}}\"], \"mcp_asset_ids\": [], \"skill_ids\": [], \"skill_hook\": {}}"
            },
            "description": "创建项目 Agent。mcp_asset_ids 必须已对项目授权（agent_id 为空的 mcp_grants）；创建时再写入 Agent 级授权。skill_ids/skill_hook 仅预留。"
          }
        },
        {
          "name": "Agent 引用对话",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/agents/{{agent_id}}/chat",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"question\": \"??????????\", \"gateway_api_key\": \"replace-with-employee-key\"}"
            }
          }
        },
        {
          "name": "管理 Bot 用量问答",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/v1/bot/chat",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"question\": \"本月用量和成本是多少？\"}"
            },
            "description": "仅 platform_admin 可调用的只读租户用量问答；不接受 tenant/org 越权参数，不执行配置写入，也不出现在 finance_auditor 菜单。"
          }
        },
        {
          "name": "列出项目 Agent",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/projects/{{project_id}}/agents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "列出当前项目启用的 Agent 及 KB/MCP 绑定。"
          }
        }
      ]
    },
    {
      "name": "12 用量与财务（Plan 07b）",
      "item": [
        {
          "name": "用量看板汇总",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/usage/summary?from={{from_utc}}&to={{to_utc}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "按 UTC 日、组织、项目聚合 LLM 网关 api_logs 与 MCP mcp_usage_logs，并返回配额利用率。from 包含、to 排他；省略 project_id 表示全部项目（含未归因调用），按需追加 organization_id={{organization_id}} 或 project_id={{project_id}}。每日行包含 calls、llm_calls、mcp_calls、input_tokens、output_tokens、cost_micros、llm_cost_micros、mcp_cost_micros、estimated_calls。MCP 成本缺失时原始值保持 NULL，汇总按 0 计并增加 estimated_calls。"
          }
        },
        {
          "name": "导出成本汇总 CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/usage/cost-rollup.csv?from={{from_utc}}&to={{to_utc}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "真正的 LLM + MCP day + organization + project 财务 rollup CSV，不是原始调用日志。过滤逻辑与 summary 完全相同；省略 project_id 为全部项目（含未归因调用）。列：day,organization_id,organization_name,project_id,project_name,calls,llm_calls,mcp_calls,input_tokens,output_tokens,cost_micros,llm_cost_micros,mcp_cost_micros,estimated_calls。"
          }
        }
      ]
    }
  ]
}
