              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/organizations",
            "description": "## 创建部门\n\n`POST /v1/organizations`\n\n同租户内部门名唯一。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"研发部\"\n}"
