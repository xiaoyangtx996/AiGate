                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/organizations/{{organization_id}}",
            "description": "## 删除部门\n\n`DELETE /v1/organizations/{id}`\n\n若仍有用户挂接，可能删除失败。"
          }
        }
      ]
    },
    {
      "name": "05 项目成员授权",
      "item": [
        {
          "name": "授予项目成员",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/members/{{user_id}}",
            "description": "## 授予项目成员\n\n`PUT /v1/projects/{projectID}/members/{userID}`\n\n项目是资产容器，成员 ACL **独立于**部门树。"
          }
        },
        {
          "name": "撤销项目成员",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/members/{{user_id}}",
            "description": "## 撤销项目成员\n\n`DELETE /v1/projects/{projectID}/members/{userID}`"
          }
        },
        {
          "name": "检查项目访问权",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/access",
            "description": "## 检查项目访问权\n\n`GET /v1/projects/{projectID}/access`\n\n返回当前身份是否允许访问该项目：`{\"allowed\": true/false}`。"
          }
        }
      ]
    },
    {
      "name": "06 网关管理（密钥/配额/渠道）",
      "item": [
        {
          "name": "创建上游渠道",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/channels",
            "description": "## 创建上游渠道\n\n`POST /v1/channels`\n\n```json\n{\n  \"name\": \"stepfun\",\n  \"base_url\": \"https://api.stepfun.com/step_plan/v1\",\n  \"credential\": \"<阶跃密钥>\"\n}\n```\n\n- MVP 每租户只允许 **一个启用中的渠道**；新建会自动停用其它渠道\n- `credential` AES-GCM 加密落库，响应不回显明文\n- `base_url` 以 `/v1` 结尾时，网关拼 `{base}/chat/completions`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"stepfun\",\n  \"base_url\": \"https://api.stepfun.com/step_plan/v1\",\n  \"credential\": \"REPLACE_STEPFUN_KEY\"\n}"
            }
          }
        },
        {
          "name": "列出上游渠道",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/channels",
            "description": "## 列出上游渠道\n\n`GET /v1/channels`\n\n返回当前租户渠道列表（不含 credential 明文）。请将启用中的 `id` 写入 `channel_id`。"
          }
        },
        {
          "name": "更新上游渠道",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/channels/{{channel_id}}",
            "description": "## 更新上游渠道\n\n`PUT /v1/channels/{id}`\n\n可部分更新：`name`、`base_url`、`credential`、`active`。\n\n将 `active=true` 时会停用同租户其它渠道（切换上游）。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"stepfun\",\n  \"base_url\": \"https://api.stepfun.com/step_plan/v1\",\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "设置模型单价",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/model-prices/step-3.5-flash",
            "description": "## 设置模型单价\n\n`PUT /v1/model-prices/{model}`\n\n- `model`：对外模型名（员工请求里用的名字）\n- `upstream_model`：上游真实模型名\n- 单价单位：micro-USD / 百万 tokens\n\n可用模型示例：`step-3.5-flash`、`step-3.7-flash`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upstream_model\": \"step-3.5-flash\",\n  \"input_micros_per_million\": 100000,\n  \"output_micros_per_million\": 300000\n}"
            }
          }
        },
        {
          "name": "设置租户配额",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/quotas/tenant/{{tenant_id}}",
            "description": "## 设置租户配额\n\n`PUT /v1/quotas/tenant/{id}`\n\n需满足守恒：上级限额 ≥ 下级限额之和（租户 → 部门 → 员工）。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit_tokens\": 1000000\n}"
            }
          }
        },
        {
          "name": "设置部门配额",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/quotas/organization/{{organization_id}}",
            "description": "## 设置部门配额\n\n`PUT /v1/quotas/organization/{id}`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit_tokens\": 1000000\n}"
            }
          }
        },
        {
          "name": "设置员工配额",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/quotas/user/{{user_id}}",
            "description": "## 设置员工配额\n\n`PUT /v1/quotas/user/{id}`\n\n未传 `max_tokens` 时网关预占约 256 output，请把员工限额设够；建议调用时显式传 `max_tokens`。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit_tokens\": 1000000\n}"
            }
          }
        },
        {
          "name": "列出 API 密钥",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/api-keys",
            "description": "## 列出 API 密钥\n\n`GET /v1/api-keys`\n\n只返回元数据（前缀、CIDR、是否启用），**不含**明文 secret。"
          }
        },
        {
          "name": "签发 API 密钥",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/api-keys",
            "description": "## 签发 API 密钥\n\n`POST /v1/api-keys`\n\n`secret` **仅返回一次**，请立刻写入变量 `api_key_secret`。存储为 SHA-256 哈希；可配置 `allowed_cidrs`。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization_id\": \"{{organization_id}}\",\n  \"user_id\": \"{{user_id}}\",\n  \"name\": \"联调密钥\",\n  \"allowed_cidrs\": [\n    \"127.0.0.1/32\",\n    \"::1/128\"\n  ]\n}"
            }
          }
        },
        {
          "name": "吊销 API 密钥",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/api-keys/{{api_key_id}}",
            "description": "## 吊销 API 密钥\n\n`DELETE /v1/api-keys/{id}`\n\n软停用（`active=false`），保留日志引用。"
          }
        },
        {
          "name": "查询调用日志",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/api-logs?limit=50",
            "description": "## 查询调用日志\n\n`GET /v1/api-logs`\n\n查询参数：\n- `user_id`（可选）\n- `blocked`（可选，`true`/`false`）\n- `limit`（可选，默认 50，最大 200）\n\n按 `created_at` 倒序返回本租户 `api_logs`。"
          }
        }
      ]
    },
    {
      "name": "07 审计与告警（Plan 03b）",
      "item": [
        {
          "name": "查询审计事件",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/audit-events?limit=50",
            "description": "## 查询审计事件\n\n`GET /v1/audit-events`\n\n查询参数：`from`、`to`（RFC3339）、`trace_id`、`event_type`、`limit`。\n\n网关写 `api_logs` 时同事务写入 `audit_events`（如 `gateway.call` / `quota.blocked`）。"
          }
        },
        {
          "name": "导出审计事件 CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/audit-events.csv?limit=50",
            "description": "## 导出审计事件 CSV\n\n`GET /v1/audit-events.csv`\n\n过滤条件与 JSON 列表相同。响应 `Content-Type: text/csv; charset=utf-8`。"
          }
        },
        {
          "name": "获取告警策略",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/alert-policy",
            "description": "## 获取告警策略\n\n`GET /v1/alert-policy`\n\n未配置时返回默认阈值 `70/90/100`、`cooldown_seconds=3600`、`enabled=true`。"
          }
        },
        {
          "name": "设置告警策略",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/alert-policy",
            "description": "## 设置告警策略\n\n`PUT /v1/alert-policy`\n\n- `thresholds`：1–100 的百分比数组\n- `webhook_url`：http(s) 地址；空字符串表示只落库不投递\n- `cooldown_seconds`：去重窗口\n- `enabled`：可省略，省略时默认为 `true`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"thresholds\": [70, 90, 100],\n  \"webhook_url\": \"https://example.com/aigate-hook\",\n  \"cooldown_seconds\": 3600,\n  \"enabled\": true\n}"
            }
          }
        },
        {
          "name": "查询告警列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/alerts?limit=50",
            "description": "## 查询告警列表\n\n`GET /v1/alerts`\n\n返回本租户配额阈值告警；`delivery_status` 含 `pending` / `delivered` / `failed` / `not_configured`。\n需运行 `cmd/worker` 才会把 `alert.webhook` job 投递出去。"
          }
        }
      ]
    },
    {
      "name": "08 项目知识库 RAG（Plan 04）",
      "item": [
        {
