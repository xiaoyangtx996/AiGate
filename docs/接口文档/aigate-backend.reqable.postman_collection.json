  "item": [
    {
      "name": "01 认证与健康检查",
      "item": [
        {
          "name": "健康检查",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/healthz",
            "description": "## 健康检查\n\n`GET /healthz`\n\n管理 API 存活探测。成功返回 `{\"status\":\"ok\"}`。"
          }
        },
        {
          "name": "就绪检查",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/readyz",
            "description": "## 就绪检查\n\n`GET /readyz`\n\n数据库可连接时返回 `200 {\"status\":\"ready\"}`；不可连接时返回 `503 {\"status\":\"unavailable\"}`。"
          }
        },
        {
          "name": "登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/v1/auth/login",
            "description": "## 登录\n\n`POST /v1/auth/login`\n\n返回 JWT。请将响应里的 `token` 写入集合变量 `jwt`。\n\n### 请求体\n- `tenant_id`：租户 UUID\n- `email`：登录邮箱\n- `password`：密码\n\n### 响应示例\n```json\n{\"token\":\"...\",\"token_type\":\"Bearer\"}\n```",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"change-me\"\n}"
            }
          }
        },
        {
          "name": "读取当前会话与菜单",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/session",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "后端权威返回当前身份与菜单。平台身份 / platform_admin 获得完整菜单；finance_auditor 获得 usage + logs；project_member 获得 projects + knowledge + agents；多角色取并集，最后受 tenant_menu_settings 裁剪。仅有自定义角色时不隐式授予菜单。"
          }
        }
      ]
    },
    {
      "name": "02 用户管理",
      "item": [
        {
          "name": "列出用户",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/users",
            "description": "## 列出用户\n\n`GET /v1/users`\n\n需要 `platform_admin`。仅返回当前 JWT 所属租户内的用户。"
          }
        },
        {
          "name": "创建用户",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/users",
            "description": "## 创建用户\n\n`POST /v1/users`\n\n创建员工并挂到部门；可通过 `role_ids` 授予角色。创建成功后把返回的 `id` 写入 `user_id`。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization_id\": \"{{organization_id}}\",\n  \"email\": \"member@example.com\",\n  \"display_name\": \"成员\",\n  \"password\": \"change-me\",\n  \"active\": true,\n  \"role_ids\": []\n}"
            }
          }
        },
        {
          "name": "更新用户",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/users/{{user_id}}",
            "description": "## 更新用户\n\n`PUT /v1/users/{id}`\n\n更新显示名、部门、角色等。`password` 为空表示不改密码。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization_id\": \"{{organization_id}}\",\n  \"email\": \"member@example.com\",\n  \"display_name\": \"成员-已更新\",\n  \"password\": \"\",\n  \"active\": true,\n  \"role_ids\": []\n}"
            }
          }
        },
        {
          "name": "调整用户所属部门",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/users/{{user_id}}/organization",
            "description": "## 调整用户所属部门\n\n`PUT /v1/users/{id}/organization`\n\n将员工挂到本租户内另一部门；禁止跨租户挂接。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization_id\": \"{{organization_id}}\"\n}"
            }
          }
        },
        {
          "name": "删除用户",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/users/{{user_id}}",
            "description": "## 删除用户\n\n`DELETE /v1/users/{id}`\n\n删除本租户用户。跨租户 ID 应返回 404。"
          }
        }
      ]
    },
    {
      "name": "03 角色管理",
      "item": [
        {
          "name": "列出角色",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/roles",
            "description": "## 列出角色\n\n`GET /v1/roles`\n\n含系统角色：`platform_admin`（平台管理员）、`project_member`（项目成员）、`finance_auditor`（财务审计只读）。同一用户可持有多个角色，会话菜单按角色并集返回。"
          }
        },
        {
          "name": "创建角色",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/roles",
            "description": "## 创建角色\n\n`POST /v1/roles`\n\n`code` 需小写；系统角色不可通过普通 CRUD 删除或改码。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"finance\",\n  \"name\": \"财务只读\",\n  \"description\": \"财务/审计只读角色\"\n}"
            }
          }
        },
        {
          "name": "更新角色",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/roles/{{role_id}}",
            "description": "## 更新角色\n\n`PUT /v1/roles/{id}`\n\n可改名称与说明；系统角色限制更多。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"财务只读\",\n  \"description\": \"已更新说明\"\n}"
            }
          }
        },
        {
          "name": "删除角色",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/roles/{{role_id}}",
            "description": "## 删除角色\n\n`DELETE /v1/roles/{id}`\n\n仅自定义角色可删。"
          }
        }
      ]
    },
    {
      "name": "04 部门管理",
      "item": [
        {
          "name": "列出部门",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/organizations",
            "description": "## 列出部门\n\n`GET /v1/organizations`\n\nMVP 组织深度：租户 → 部门 → 员工。"
          }
        },
        {
          "name": "创建部门",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/organizations",
            "description": "## 创建部门\n\n`POST /v1/organizations`\n\n同租户内部门名唯一。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"研发部\"\n}"
            }
          }
        },
        {
          "name": "更新部门",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/organizations/{{organization_id}}",
            "description": "## 更新部门\n\n`PUT /v1/organizations/{id}`",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"信息技术部\"\n}"
            }
          }
        },
        {
          "name": "删除部门",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/organizations/{{organization_id}}",
            "description": "## 删除部门\n\n`DELETE /v1/organizations/{id}`\n\n若仍有用户挂接，可能删除失败。"
          }
        }
      ]
    },
    {
      "name": "05 项目成员授权",
      "item": [
        {
          "name": "授予项目成员",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/members/{{user_id}}",
            "description": "## 授予项目成员\n\n`PUT /v1/projects/{projectID}/members/{userID}`\n\n项目是资产容器，成员 ACL **独立于**部门树。"
          }
        },
        {
          "name": "撤销项目成员",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/members/{{user_id}}",
            "description": "## 撤销项目成员\n\n`DELETE /v1/projects/{projectID}/members/{userID}`"
          }
        },
        {
          "name": "检查项目访问权",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{api_base}}/v1/projects/{{project_id}}/access",
            "description": "## 检查项目访问权\n\n`GET /v1/projects/{projectID}/access`\n\n返回当前身份是否允许访问该项目：`{\"allowed\": true/false}`。"
          }
        },
        {
          "name": "列出项目",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/projects",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "管理员按当前租户列出全部项目。"
          }
        },
        {
          "name": "创建项目",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api_base}}/v1/projects",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Demo3 项目\",\"organization_id\":\"{{organization_id}}\"}"
            },
            "description": "部门不存在时返回 404；成功后自动将创建者加入项目成员。"
          }
        },
        {
          "name": "列出可访问项目上下文",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/project-contexts",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "管理员返回当前租户项目；项目成员（含财务+项目双角色）仅返回 membership 项目。用量页的财务全租户筛选使用 /v1/project-contexts?scope=usage。"
          }
        },
        {
          "name": "列出用量筛选项目上下文",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/project-contexts?scope=usage",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
            },
            "description": "仅管理员或 finance_auditor 用于租户级用量筛选；资产页不要使用此 scope。"
          }
        },
        {
          "name": "批量列出项目成员",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/project-members",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
            },
            "description": "返回 project_id 到成员数组的映射；管理员为租户项目，项目成员仅为自己可访问项目。"
          }
        },
        {
          "name": "批量列出项目成员候选",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/project-member-candidates",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
            },
            "description": "返回 project_id 到候选人数组的映射；候选人限于项目所属组织内、active 且尚未加入该项目的员工。"
          }
        },
        {
          "name": "列出项目成员",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/projects/{{project_id}}/members",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "列出当前项目成员。"
          }
        },
        {
          "name": "列出项目成员候选",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_base}}/v1/projects/{{project_id}}/member-candidates",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "管理员或已有项目 membership 的 project_member 可列出成员授权候选。结果仅含项目所属 organization 内 active 且尚未加入该项目的员工，不再返回全租户用户目录。"
          }
        }
      ]
    },
