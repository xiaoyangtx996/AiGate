# Copy to .env and replace every REPLACE_* value before starting Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
POSTGRES_DB=AiGate
POSTGRES_PORT=5432
AIGATE_DATABASE_URL=postgresql://postgres:REPLACE_POSTGRES_PASSWORD@postgres:5432/AiGate?sslmode=disable

AIGATE_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AIGATE_CHANNEL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
AIGATE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY_CIDRS=

AIGATE_BOOTSTRAP_TENANT_ID=11111111-1111-1111-1111-111111111111
AIGATE_BOOTSTRAP_TENANT_NAME=AiGate Pilot
AIGATE_BOOTSTRAP_ORGANIZATION_ID=22222222-2222-2222-2222-222222222222
AIGATE_BOOTSTRAP_ORGANIZATION_NAME=IT
AIGATE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AIGATE_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_BOOTSTRAP_ADMIN_PASSWORD

AIGATE_OBJECT_STORAGE_PATH=/app/data/objects
AIGATE_OBJECT_MAX_BYTES=20971520
AIGATE_EMBEDDING_BASE_URL=
AIGATE_EMBEDDING_API_KEY=
AIGATE_EMBEDDING_MODEL=text-embedding-3-small
AIGATE_EMBEDDING_DIMENSIONS=384

# Browser-visible URLs are compiled into the SPA image at build time.
VITE_API_BASE_URL=http://localhost:8080
VITE_GATEWAY_BASE_URL=http://localhost:8081
