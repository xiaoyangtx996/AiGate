# ⚠️ 安全警告
# 1. 复制此文件为 .env 后，请立即修改所有默认密码
# 2. 切勿将 .env 文件提交到版本控制
# 3. 生产环境必须使用强密码和加密连接

# 数据库连接（必填）
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/AiGate

# Better Auth（必填）
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-long
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_ADMIN_USER_IDS=

# 应用配置
NUXT_APP_NAME=AiGate
NUXT_APP_DESC=Enterprise AI Management Platform
NODE_ENV=development

# Sentry 错误监控（生产环境推荐）
SENTRY_DSN=

# Resend 邮件服务（可选）
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM=noreply@aigate.com

# GitHub（可选，用于服务端获取 Release）
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth（可选）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
