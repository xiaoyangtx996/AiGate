{
  "openapi": "3.0.3",
  "info": {
    "title": "AiGate API",
    "description": "Enterprise AI Management Platform — core REST endpoints under /api/aigate",
    "version": "1.7.1"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Current host"
    }
  ],
  "tags": [
    { "name": "Agent", "description": "AI agent management" },
    { "name": "Prompt", "description": "Prompt templates and versions" },
    { "name": "ApiKey", "description": "API key lifecycle" },
    { "name": "Search", "description": "Global search" },
    { "name": "Dashboard", "description": "Usage analytics dashboard" },
    { "name": "Channel", "description": "Model channel configuration" },
    { "name": "KnowledgeBase", "description": "Knowledge base and documents" },
    { "name": "Organization", "description": "Organization management" },
    { "name": "Alert", "description": "Alert rules and notifications" },
    { "name": "Billing", "description": "Billing and usage reports" }
  ],
  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Better Auth session cookie"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "msg": { "type": "string", "example": "success" },
          "data": {},
          "timestamp": { "type": "integer", "format": "int64" }
        }
      },
      "PaginatedResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponse" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "items": { "type": "array", "items": {} },
                  "total": { "type": "integer" },
                  "page": { "type": "integer" },
                  "pageSize": { "type": "integer" }
                }
              }
            }
          }
        ]
      }
    }
  },
  "security": [{ "sessionAuth": [] }],
  "paths": {
    "/aigate/agent": {
      "get": {
        "tags": ["Agent"],
        "summary": "List agents",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Agent list",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginatedResponse" } } }
          }
        }
      },
      "post": {
        "tags": ["Agent"],
        "summary": "Create agent",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": { "description": "Created agent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/agent/{id}": {
      "get": {
        "tags": ["Agent"],
        "summary": "Get agent by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Agent detail", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "put": {
        "tags": ["Agent"],
        "summary": "Update agent",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "Updated agent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Agent"],
        "summary": "Delete agent",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/agent/{id}/chat": {
      "post": {
        "tags": ["Agent"],
        "summary": "Chat with agent",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "message": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "Chat response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/prompt": {
      "get": {
        "tags": ["Prompt"],
        "summary": "List prompts",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Prompt list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginatedResponse" } } } }
        }
      },
      "post": {
        "tags": ["Prompt"],
        "summary": "Create prompt",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "Created prompt", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/prompt/{id}": {
      "put": {
        "tags": ["Prompt"],
        "summary": "Update prompt",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "Updated prompt", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Prompt"],
        "summary": "Delete prompt",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/prompt/{id}/versions": {
      "get": {
        "tags": ["Prompt"],
        "summary": "List prompt versions",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Version list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/api-key": {
      "get": {
        "tags": ["ApiKey"],
        "summary": "List API keys",
        "responses": {
          "200": { "description": "API key list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "tags": ["ApiKey"],
        "summary": "Create API key",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "Created key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/api-key/{id}": {
      "put": {
        "tags": ["ApiKey"],
        "summary": "Update API key",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "Updated key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "delete": {
        "tags": ["ApiKey"],
        "summary": "Revoke API key",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Revoked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/search": {
      "get": {
        "tags": ["Search"],
        "summary": "Global search",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["agent", "prompt", "knowledge-base", "all"] } }
        ],
        "responses": {
          "200": { "description": "Search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/dashboard": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Dashboard metrics",
        "parameters": [
          { "name": "range", "in": "query", "schema": { "type": "string", "enum": ["7d", "30d", "90d"], "default": "7d" } }
        ],
        "responses": {
          "200": { "description": "Dashboard data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/channel": {
      "get": {
        "tags": ["Channel"],
        "summary": "List model channels",
        "responses": {
          "200": { "description": "Channel list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "tags": ["Channel"],
        "summary": "Create channel",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "Created channel", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/knowledge-base": {
      "get": {
        "tags": ["KnowledgeBase"],
        "summary": "List knowledge bases",
        "responses": {
          "200": { "description": "Knowledge base list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "tags": ["KnowledgeBase"],
        "summary": "Create knowledge base",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/organization": {
      "get": {
        "tags": ["Organization"],
        "summary": "List organizations",
        "responses": {
          "200": { "description": "Organization list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/organization/tree": {
      "get": {
        "tags": ["Organization"],
        "summary": "Organization tree",
        "responses": {
          "200": { "description": "Tree structure", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/alert/rule": {
      "get": {
        "tags": ["Alert"],
        "summary": "List alert rules",
        "responses": {
          "200": { "description": "Alert rules", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "tags": ["Alert"],
        "summary": "Create alert rule",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": { "description": "Created rule", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/aigate/billing": {
      "get": {
        "tags": ["Billing"],
        "summary": "List billing records",
        "responses": {
          "200": { "description": "Billing list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    }
  }
}
